<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Edit</title>
</head>

<body>
    <form class="container mt-5 " action="/update-user" method="POST">
        <%=JSON.stringify(user_edit)%>
            <legend>
                <h3>EDIT USER</h3>
            </legend>
            <div class="mb-3">
                <input class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp" name="id"
                    value="<%=user_edit.id%>" type="hidden">
            </div>
            <div class="mb-3">
                <label for="exampleInputEmail1" class="form-label">Email address</label>
                <input type="email" class="form-control" id="exampleInputEmail1" aria-describedby="emailHelp"
                    name="email" value="<%=user_edit.email%>">
            </div>
            <div class="mb-3">
                <label for="exampleInputPassword1" class="form-label">Name</label>
                <input type="text" class="form-control" id="exampleInputPassword1" name="name"
                    value="<%=user_edit.name%>">
            </div>
            <div class="mb-3">
                <label for="exampleInputcity" class="form-label">City</label>
                <input type="text" class="form-control" id="exampleInputPassword1" name="city"
                    value="<%=user_edit.city%>">
            </div>

            <button type="submit" class="btn btn-primary">SAVE</button>
    </form>
    </fieldset>
</body>

</html>